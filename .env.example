# Production realtime WebSocket endpoint. Local development defaults to localhost:8787.
NEXT_PUBLIC_MULTIPLAYER_URL=wss://freetong-life.aliekargbo000.workers.dev/ws
# Server-only Cloudflare Worker API base URL and matching secret token.
CLOUDFLARE_API_URL=https://freetong-life.aliekargbo000.workers.dev
CLOUDFLARE_API_TOKEN=replace-with-a-long-random-secret
# Server-only Vercel Web Analytics API credentials (never expose with NEXT_PUBLIC_).
VERCEL_WEB_ANALYTICS_TOKEN=replace-with-a-vercel-access-token
VERCEL_PROJECT_ID=replace-with-your-vercel-project-id
# Set this only when the Vercel project belongs to a team.
VERCEL_TEAM_ID=
# Local development uses PostgreSQL when DATABASE_URL is set.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/postgres
