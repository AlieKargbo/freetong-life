{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "freetong-life-app",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "freetong-life-app"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freetong-life",
      "database_id": "4d78e891-3d14-4751-a63b-ed2794de2d70",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
